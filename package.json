{
  "name": "flux-project-manager",
  "version": "0.1.0",
  "description": "Desktop project manager for Node.js, Python, Java, and Monorepo projects",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:app": "npm run electron:dev",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:store": "vitest run electron/core/store.test.ts",
    "test:detectors": "vitest run electron/detectors/detectors.test.ts",
    "test:watch": "vitest",
    "check:quick": "npm run typecheck && npm run test",
    "check": "npm run test && npm run build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.104",
    "@anthropic-ai/claude-code": "^2.1.104",
    "@vicons/ionicons5": "^0.12.0",
    "naive-ui": "^2.38.0",
    "pinia": "^2.1.0",
    "simple-git": "^3.35.2",
    "ts-morph": "^28.0.0",
    "uuid": "^9.0.0",
    "vue": "^3.4.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.0",
    "node-pty": "^1.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0",
    "wait-on": "^7.2.0"
  }
}
